ENVIRONMENT=local
API_PORT=3005
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Supabase PostgreSQL direct or session-pooler URL. The app normalizes postgres:// URLs.
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Use Supabase in staging/production. Local mode exists only for Docker development.
AUTH_MODE=supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
LOCAL_JWT_SECRET=replace-with-at-least-32-random-characters

OPENAI_API_KEY=replace_me
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
EMBEDDING_DIMENSIONS=768

# Keep these synchronized with the selected model's current public pricing.
LLM_INPUT_COST_PER_MILLION_USD=0.05
LLM_OUTPUT_COST_PER_MILLION_USD=0.40

RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.45
HUMAN_APPROVAL_ENABLED=true
METRICS_BEARER_TOKEN=replace_me
OTEL_EXPORTER_OTLP_ENDPOINT=
